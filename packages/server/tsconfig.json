{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is type-only (for puppeteer page-evaluate callbacks); the tsup build
    // targets Node and emits no DOM runtime.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
